{
  "name": "voxen",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Voxen — a browser-based AI voice agent with web search and spoken answers.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "eval": "node --experimental-strip-types scripts/evals.mts",
    "eval:gate": "node --experimental-strip-types scripts/evals.mts --gate",
    "eval:live": "node --experimental-strip-types scripts/evals.mts --traces .data/eval-traces.jsonl",
    "eval:baseline": "node --experimental-strip-types scripts/evals.mts --write-baseline evals/baseline.json",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "next": "^16.4.6",
    "openai": "^7.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "redis": "^6.4.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
