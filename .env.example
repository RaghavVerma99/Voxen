# --- Required ---
OPENAI_API_KEY=

# --- Models ---
# gpt-transcribe returns JSON; the app reads the `.text` field.
STT_MODEL=gpt-transcribe
LLM_MODEL=gpt-6-luna
# Chat Completions tool calls on gpt-6-luna require "none".
# Set to default/off/empty to omit the parameter for other models.
LLM_REASONING_EFFORT=none
# gpt-4o-mini-tts shuts down 2027-01-06; no drop-in /v1/audio/speech replacement.
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
MAX_TOOL_ROUNDS=4
MAX_REPLY_TOKENS=600
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2

# --- Web search ---
# auto = Tavily when TAVILY_API_KEY is set, otherwise keyless DuckDuckGo
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
SEARCH_TIMEOUT_MS=8000

# --- Conversation state ---
MAX_HISTORY_MESSAGES=20
SESSION_TTL_MS=1800000
MAX_SESSIONS=1000

# --- Limits & cost controls ---
MAX_AUDIO_BYTES=4194304
MAX_AUDIO_SECONDS=60
MAX_MESSAGE_CHARS=4000
MAX_CHAT_REQUEST_BYTES=65536
MAX_VOICE_REQUEST_BYTES=4718592
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_MS=60000
DAILY_REQUEST_BUDGET=1000

# --- Streaming lifecycle ---
TURN_TIMEOUT_MS=90000
SSE_HEARTBEAT_MS=15000

# --- Proxy trust ---
# Number of trusted proxies in front of the app. Auto-detects 1 only on
# Vercel/Render/Fly; otherwise 0 (ignore X-Forwarded-For). Railway and custom
# proxies must set this explicitly.
# TRUST_PROXY_HOPS=1

# --- Access gate ---
# Required in production (NODE_ENV=production). Use 16+ random characters.
# Without it, guarded routes return 503 and /api/ready reports not-ready.
ACCESS_CODE=
MIN_ACCESS_CODE_LENGTH=16
# Set to false only for a deliberately public production deploy.
REQUIRE_ACCESS_CODE=true

# --- Metadata ---
APP_VERSION=1.1.0
