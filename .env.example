# --- Required ---
OPENAI_API_KEY=

# --- Models ---
STT_MODEL=gpt-4o-mini-transcribe
LLM_MODEL=gpt-4o-mini
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
MAX_TOOL_ROUNDS=4
MAX_REPLY_TOKENS=600
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2

# --- Web search ---
# auto = Tavily when TAVILY_API_KEY is set, otherwise keyless DuckDuckGo
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
SEARCH_TIMEOUT_MS=8000

# --- Conversation state ---
MAX_HISTORY_MESSAGES=20
SESSION_TTL_MS=1800000
MAX_SESSIONS=1000

# --- Limits & cost controls ---
MAX_AUDIO_BYTES=4194304
MAX_AUDIO_SECONDS=60
MAX_MESSAGE_CHARS=4000
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_MS=60000
DAILY_REQUEST_BUDGET=1000

# --- Optional private preview gate ---
# When set, the API requires an `x-access-code` header matching this value.
ACCESS_CODE=

# --- Metadata ---
APP_VERSION=1.0.0
